  "faq": {
    "title": "Domande Frequenti",
    "subtitle": "Trova risposte alle domande più comuni",
    "tenant": {
      "title": "Per Inquilini",
      "q1": {
        "question": "Come cerco le proprietà disponibili?",
        "answer": "Puoi cercare le proprietà usando i filtri di ricerca inclusi posizione, fascia di prezzo, tipo di proprietà e servizi. Salva i tuoi preferiti per una facile consultazione."
      },
      "q2": {
        "question": "Come pago l'affitto online?",
        "answer": "Una volta che il tuo contratto è attivo, puoi pagare l'affitto tramite la dashboard usando carta di credito, bonifico bancario o addebito automatico."
      },
      "q3": {
        "question": "Come invio una richiesta di manutenzione?",
        "answer": "Vai alla sezione manutenzione nella dashboard, descrivi il problema, allega eventuali foto e invia. Sarai notificato quando verrà affrontato."
      }
    },
    "landlord": {
      "title": "Per Proprietari",
      "q1": {
        "question": "Come pubblico una proprietà?",
        "answer": "Clicca su 'Aggiungi Proprietà' nella dashboard, inserisci i dettagli incluse foto, prezzo di affitto e servizi, quindi pubblicala per gli inquilini."
      },
      "q2": {
        "question": "Come valuto i potenziali inquilini?",
        "answer": "Rivedi le candidature nella dashboard delle proprietà. Puoi visualizzare i profili dei candidati, verificare referenze e approvare o rifiutare candidature."
      },
      "q3": {
        "question": "Come riscuoto l'affitto?",
        "answer": "La nostra piattaforma gestisce la riscossione automatica dell'affitto. Imposta il tuo metodo di pagamento preferito e gli inquilini saranno addebitati automaticamente ogni mese."
      }
    },
    "manager": {
      "title": "Per Gestori Immobiliari",
      "q1": {
        "question": "Posso gestire più proprietà per diversi proprietari?",
        "answer": "Sì, il nostro piano aziendale ti permette di gestire proprietà di più proprietari con account separati e report."
      },
      "q2": {
        "question": "Come configuro i ruoli del team?",
        "answer": "Vai a impostazioni del team per invitare membri del team e assegnare ruoli con diversi livelli di permesso per la gestione delle proprietà."
      }
    }
  },
